# Copy to .env (optional; every value has a default).

# Sepolia RPCs, comma-separated. Must allow eth_getLogs and eth_call at recent blocks.
# All are used: the fastest healthy one leads, the others take over when it fails.
# Put a free Alchemy/Infura key first for the most reliable sync.
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com,https://11155111.rpc.thirdweb.com

# Web server
PORT=8787
# 0.0.0.0 to open it to other machines on your network
HOST=127.0.0.1

# ---- public hosting (see DEPLOY.md)
# your domain, used by docker compose + Caddy for HTTPS
# DOMAIN=squeek.example.com
# requests per second each visitor may make (bursts of 4x); 0 turns the limit off
RATE_LIMIT=30
# 1 when Caddy / nginx / Cloudflare sits in front (docker compose sets this for you)
TRUST_PROXY=0

# Lower this if your RPC rejects large getLogs ranges (the indexer also halves it automatically)
LOG_CHUNK=10000
# Seconds between checks for new blocks, and between full position snapshots
POLL_SECONDS=30
POSITIONS_SECONDS=120

# 1 = fetch and pre-render every Squeek's image in the background so the grid loads from disk (0 to turn off)
WARM_IMAGES=1

# Squeekchain API for this deployment (metadata, economy, accounts, wheel status)
# API_BASE=https://green-dispenser-04.squeekchain.com

# Squeekchain deployment of 24 Oct 2026 (defaults); override only if Squeekchain redeploys
# NFT_ADDRESS=0x05142852d9eaf3e66a7a74419e363bd3539467b0
# VAULT_ADDRESS=0x90112ed64e1a92aaf107736ace9584b8745020eb
# CORE_ADDRESS=0x2aec8094ed6840eff95d284c55cd2585c4de6814
# MINING_ADDRESS=0xac45fe7e42b8a0a44c02f9c8a507e137322cff7a
